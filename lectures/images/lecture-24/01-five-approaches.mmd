flowchart LR
    classDef in fill:#cfe8ff,stroke:#4a86c8,color:#000
    classDef model fill:#ffd166,stroke:#c9961a,color:#000
    classDef out fill:#d4f5d4,stroke:#3f9d5a,color:#000
    classDef fix fill:#ffd6d6,stroke:#d45c5c,color:#000

    TR["Turkish command<br/><i>soldaki siyah kaseyi al ve tabağın üstüne koy</i>"]:::in
    IMG["Image 224x224"]:::in
    TOK["Tokenizer<br/>LLaMA-2 / Qwen3"]:::model
    VLM["VLM backbone<br/>image + text → hidden state"]:::model
    HEAD["Policy head<br/>256-bin token / flow-matching"]:::model
    ACT["7-DoF action"]:::out

    TR --> TOK --> VLM --> HEAD --> ACT
    IMG --> VLM

    A1["1 · Translation layer (MT)<br/>NLLB / Opus-MT / Google<br/>TR → free-form EN sentence<br/><b>does not touch the model</b>"]:::fix
    A5["4 · Parser + symbolic<br/>rules / LLM → (verb, target, relation, reference)<br/>→ EN template or BDDL predicate<br/><b>does not touch the model, verifiable</b>"]:::fix
    A2["2 · Multilingual backbone<br/>e.g. Qwen3-VL (119 languages)<br/>VLM that has already seen TR<br/><b>model choice</b>"]:::fix
    A3["3 · Turkish LoRA / co-training<br/>same demos, TR command<br/>r=32, 1.4% of parameters<br/><b>weights change</b>"]:::fix
    A4["5 · Hidden-state alignment<br/>step-wise shift (Dong) / MPCA (Chen)<br/><b>translation at the representation level</b>"]:::fix

    A1 -. "input" .-> TR
    A5 -. "input" .-> TR
    A2 -. "backbone" .-> VLM
    A3 -. "backbone + head (LoRA)" .-> VLM
    A3 -. " " .-> HEAD
    A4 -. "intermediate layer" .-> VLM
