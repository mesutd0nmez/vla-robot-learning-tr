flowchart LR
    classDef in fill:#cfe8ff,stroke:#4a86c8,color:#000
    classDef model fill:#ffd166,stroke:#c9961a,color:#000
    classDef out fill:#d4f5d4,stroke:#3f9d5a,color:#000
