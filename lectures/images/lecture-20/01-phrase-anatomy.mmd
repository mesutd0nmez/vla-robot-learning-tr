flowchart LR
  subgraph EN["English: the relation is a separate word, BEFORE the noun"]
    e1["on / next to / between<br/>(preposition)"]:::key --> e2["the stove"]:::inp
  end
  subgraph TR["Turkish: the relation is three suffixes on a NOUN"]
    t1["ocağ-ın<br/>reference noun + GEN"]:::inp --> t2["üst<br/>relation noun"]:::key --> t3["-ü<br/>POSS3: 'its top'"]:::key --> t4{"case suffix<br/>= ROLE"}:::key
  end
  t4 -->|"-nde + ki"| r1["üstündeki kase<br/>SELECTION: standing where?<br/>(Spatial: pick up the bowl ON ...)"]:::out
  t4 -->|"-ne"| r2["üstüne koy<br/>GOAL: to where?<br/>(Goal: put the bowl ON ...)"]:::out
  t4 -->|"-nden"| r3["üstünden al<br/>SOURCE: from where?<br/>(from table center)"]:::out
  e2 -.->|"the same 'on' stays unchanged in all three roles;<br/>the verb and the word order carry the role"| r2
  classDef key fill:#ffd166,stroke:#333,color:#000
  classDef inp fill:#cfe8ff,stroke:#333,color:#000
  classDef out fill:#d4f5d4,stroke:#333,color:#000
