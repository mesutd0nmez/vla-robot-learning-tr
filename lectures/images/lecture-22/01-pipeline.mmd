  S["command text<br/>'soldaki siyah kaseyi al ve<br/>tabağın üstüne koy'"]:::in

  subgraph L["OpenVLA — LLaMA-2 tokenizer (SentencePiece BPE, 32,000 pieces)"]
    direction LR
    L0["prompt template<br/>'In: What action should the robot<br/>take to {command.lower()}?\nOut:'"]:::in
    L1["normalizer<br/>prepend ▁ (dummy prefix),<br/>space → ▁"]:::key
