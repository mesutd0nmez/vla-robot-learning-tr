  subgraph Q["VLANeXt — Qwen3 tokenizer (byte-level BPE, 151,643 + 26 special)"]
    direction LR
    Q0["chat template<br/>&lt;|im_start|&gt;user … &lt;|vision_end|&gt;{command}&lt;|im_end|&gt;<br/>(command right after the image, no space)"]:::in
