flowchart LR
    IMG["📷 Görüntü<br/>224×224 RGB"] --> SIG["SigLIP<br/>(anlamsal özellikler)"]
    IMG --> DINO["DINOv2<br/>(mekânsal / geometrik özellikler)"]
    SIG --> CAT["kanal boyunca birleştir<br/>256 patch token"]
    DINO --> CAT
    CAT --> PROJ["Projector<br/>2 katmanlı MLP<br/>görsel → dil uzayı"]
    TXT["💬 Komut<br/>'What action should the robot take<br/>to pick up the red cup?'"] --> TOK["LLaMA-2 tokenizer<br/>BPE"]
    PROJ --> LLM["LLaMA-2 7B<br/>(decoder-only transformer)"]
    TOK --> LLM
    LLM --> OUT["7 action token<br/>(autoregressive, sırayla)"]
    OUT --> DET["de-tokenize<br/>bin → sürekli değer"]
    DET --> ACT["🦾 Δx Δy Δz Δr Δp Δy gripper"]
    style LLM fill:#ffd166,color:#000
    style PROJ fill:#cfe8ff,color:#000
    style OUT fill:#d4f5d4,color:#000
