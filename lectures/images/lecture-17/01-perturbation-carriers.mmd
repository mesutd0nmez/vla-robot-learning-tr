flowchart LR
    classDef key fill:#ffd166,stroke:#b07d00,color:#000
    classDef inp fill:#cfe8ff,stroke:#3a6ea5,color:#000
    classDef out fill:#d4f5d4,stroke:#2e7d32,color:#000
    classDef bad fill:#ffd6d6,stroke:#b00020,color:#000

    T["task_classification.json<br/>task name, e.g.<br/><i>base_language_5_view_0_0_100_0_0_initstate_0</i>"]:::inp

    subgraph A["Carrier 1: task NAME (BDDL unchanged, no assets needed)"]
        A1["_view_H_V_S_ER_EV<br/>env_wrapper.py:207-218 parse<br/>→ _setup_camera: rotate z/y, scale, end yaw/pitch"]:::key
        A2["_initstate_I<br/>robots = ['Panda' + I]<br/>→ MountedPandaI.init_qpos (7 angles)"]:::key
        A3["_noise_N (1..50)<br/>ControlEnv.step/reset:<br/>only agentview_image is corrupted"]:::key
    end

    subgraph B["Carrier 2: BDDL FILE (new .bddl, name up to _view_)"]
        B1["_language_K<br/>only (:language ...) differs<br/>→ grab_language_from_filename else-branch → .lower()"]:::key
        B2["_add_K<br/>+ objects, + add_object_region_K<br/>(3 distractors, pool of 416)"]:::key
        B3["_levelL_sampleM<br/>:regions ranges shifted by ±L cm"]:::key
    end

    subgraph C["Carrier 3: PROBLEM CLASS → scene XML (assets required)"]
        C1["_light_K → (problem ..._light_sync_modified_K)<br/>scene_xml = scenes/lights/..._K.xml"]:::key
        C2["_table_K / _tb_K → (problem ..._table_Texture[_Wall_x])<br/>scene_xml = scenes/tabletop_table_Texture.xml"]:::key
    end

    T --> A1 & A2 & A3
    T --> B1 & B2 & B3
    T --> C1 & C2

    A1 --> O1["agentview camera<br/>pos/quat"]:::out
    A2 --> O2["robot initial qpos"]:::out
    A3 --> O3["corrupted image<br/>(wrist camera clean)"]:::out
    B1 --> O4["task.language<br/>(command sent to the model)"]:::out
    B2 & B3 --> O5["object layout<br/>(placement initializer)"]:::out
    C1 & C2 --> O6["light / texture<br/>(MuJoCo scene XML)"]:::out

    N["Goal (:goal) and success criterion<br/>do NOT change in ANY of the 7 perturbations"]:::bad
    O4 -.-> N
