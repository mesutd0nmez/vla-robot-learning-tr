flowchart TB
    classDef model fill:#ffd166,stroke:#333,color:#000
    classDef input fill:#cfe8ff,stroke:#333,color:#000
    classDef output fill:#d4f5d4,stroke:#333,color:#000
    classDef problem fill:#ffd6d6,stroke:#333,color:#000
    classDef plain fill:#ffffff,stroke:#333,color:#000

    subgraph SEQ["Qwen3-VL input sequence (left to right, single example)"]
        direction LR
        T0["proprio<br/>8 steps x 7 -> 8 tokens<br/>action_projector (Linear)"]:::input
        T1["template<br/>im_start user"]:::plain
        T2["agentview<br/>256x256 -> 64 image tokens"]:::input
        T3["wrist<br/>256x256 -> 64 image tokens"]:::input
        T4["COMMAND text<br/>pick up the black bowl ... (about 20 tokens)<br/>the Turkish command goes here"]:::problem
        T5["template<br/>im_end, im_start assistant"]:::plain
        T6["16 meta queries<br/>learned vectors<br/>marked with pad id"]:::model
        T0 --- T1 --- T2 --- T3 --- T4 --- T5 --- T6
    end

    VLM["Qwen3-VL-2B: 28 transformer layers<br/>output_hidden_states=True<br/>hidden_states = (embedding, layer 1, ..., layer 28) -> 29 tensors<br/>each [B, sequence length, 2048]"]:::model

    subgraph POL["Policy: ActionDiffusionTransformerMoE (29 blocks, hidden 1024, 16 heads)"]
        direction TB
        X0["x = input_proj(noisy 8x7 action) + pos_embed<br/>t = TimestepEmbedder(flow-matching step)"]:::plain
        B1["block 1: self-attn + cross-attn<br/>key/value = [x, vlm_proj(hidden_states[0])]<br/>modulation with adaLN(t)"]:::model
        B2["block 2: key/value = [x, vlm_proj(hidden_states[1])]"]:::model
        BD["..."]:::plain
        B29["block 29: key/value = [x, vlm_proj(hidden_states[28])]"]:::model
        FL["FinalLayer1D -> velocity prediction (8x7)"]:::output
        X0 --> B1 --> B2 --> BD --> B29 --> FL
    end

    LOOP["5 Euler steps: action = scheduler.step(velocity, t, action)<br/>sigma: 1.0 -> 0.75 -> 0.50 -> 0.25 -> 0.001 -> 0<br/>result: 8 x 7 action, [-1, 1]"]:::output

    SEQ --> VLM
    VLM -- "29 hidden states, all go to the policy" --> POL
    FL --> LOOP
    LOOP -. "repeat 5 times (the VLM does not run again)" .-> X0
